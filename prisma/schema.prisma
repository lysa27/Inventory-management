// schema.prisma
datasource db {
  provider = "mysql"  // or "postgresql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl= env("SHADOW_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
   id    Int @id @default(autoincrement())
   email String @unique
   name String?
   fullName String?
   passwordHash String
   phoneNumber String?
   role String @default("PROGRAM_MANAGER")
   systemLogs   SystemLog[]
   @@map("users")
}

model SystemLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  description String  // Changed from 'message' to match actual DB
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  @@map ("system_logs")
}
