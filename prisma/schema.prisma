// schema.prisma
datasource db {
  provider = "mysql"  // or "postgresql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl= env("SHADOW_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
   id    Int @id @default(autoincrement()) // If using integers
  email String @unique
  name String?
  systemLogs   SystemLog[]  // This is the relation to SystemLog
  @@map("users") // Maps to existing "users" table
  // Other fields...
}

model SystemLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  description String  // Changed from 'message' to match actual DB
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  @@map ("system_logs")
}
